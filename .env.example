PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8100

JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=15d
JWT_RESET_SECRET=change-me-too
RESET_TOKEN_EXPIRES_IN=1h
ANDROID_MINIMUM_SUPPORTED_VERSION=2.2
ANDROID_LATEST_VERSION=2.2
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=br.com.etedaf.reservas
ANDROID_UPDATE_MESSAGE=Uma nova versão do aplicativo está disponível. Atualize para continuar usando o sistema.

TURSO_DATABASE_URL=libsql://your-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token
TURSO_ID=your-turso-database-id

RESEND_API_KEY=your-resend-api-key
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
